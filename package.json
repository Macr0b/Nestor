  "description": "Imbrication de pièces sur panneaux (laser, CNC, scie) — appli installable",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
